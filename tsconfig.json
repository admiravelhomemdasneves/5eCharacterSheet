{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "ES2020", "ES2022.Array"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
