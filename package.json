{
  "name": "fifth-edition-character-sheet",
  "version": "1.3.1",
  "private": true,
  "description": "Interactive fifth edition (2014) character sheets for Obsidian",
  "scripts": {
    "data:srd": "node scripts/build-data.ts srd",
    "data:import": "node scripts/build-data.ts import",
    "build": "node esbuild.config.mjs",
    "install-vault": "node esbuild.config.mjs --install",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "lint": "eslint src test scripts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "22.10.2",
    "esbuild": "0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.71.2"
  },
  "type": "module",
  "license": "MIT"
}
